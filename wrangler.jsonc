{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pocket-remote",
  "main": "src/cloudflare/index.ts",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/cloudflare-web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "vars": {
    "POCKET_PUBLIC_ORIGIN": "https://pocket.example.com",
  },
  "durable_objects": {
    "bindings": [
      { "name": "RELAY", "class_name": "RelayHub" },
      { "name": "MESSAGING", "class_name": "MessagingHub" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayHub", "MessagingHub"] }],
  "r2_buckets": [{ "binding": "IM_MEDIA", "bucket_name": "pocket-im-media" }],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": false },
}
