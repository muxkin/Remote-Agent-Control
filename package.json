{
  "name": "codex-pocket-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --import ./scripts/env.mjs --import tsx src/server/main.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node --import ./scripts/env.mjs dist/server/main.js",
    "pair": "node --import ./scripts/env.mjs --import tsx src/server/cli.ts pair",
    "devices": "node --import ./scripts/env.mjs --import tsx src/server/cli.ts devices",
    "doctor": "node --import ./scripts/env.mjs --import tsx scripts/doctor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write src scripts test *.json *.ts docs/*.md README.md",
    "test:live": "node --import ./scripts/env.mjs --import tsx scripts/live-smoke.ts",
    "test:cloud": "node --import ./scripts/env.mjs --import tsx scripts/cloud-smoke.ts",
    "test:pairing": "node --import ./scripts/env.mjs --import tsx scripts/pairing-smoke.ts",
    "test:browser": "node --import ./scripts/env.mjs --import tsx scripts/browser-smoke.ts",
    "test:content": "node --import ./scripts/env.mjs --import tsx scripts/content-smoke.ts",
    "test:requests": "node --import ./scripts/env.mjs --import tsx scripts/request-smoke.ts",
    "deploy:render": "node --import ./scripts/env.mjs --import tsx scripts/render-deploy.ts",
    "assets:prepare": "node --import ./scripts/env.mjs --import tsx scripts/prepare-assets.ts",
    "assets:publish": "node --import ./scripts/env.mjs --import tsx scripts/publish-assets.ts",
    "test:storage": "node --import ./scripts/env.mjs --import tsx scripts/storage-smoke.ts",
    "test:stun": "node --import ./scripts/env.mjs --import tsx scripts/stun-smoke.ts",
    "test:approvals": "node --import ./scripts/env.mjs --import tsx scripts/approval-smoke.ts",
    "test:file-approval": "node --import ./scripts/env.mjs --import tsx scripts/file-permission-smoke.ts",
    "test:queue": "node --import ./scripts/env.mjs --import tsx scripts/queue-smoke.ts",
    "test:uploads": "node --import ./scripts/env.mjs --import tsx scripts/upload-smoke.ts",
    "test:create": "node --import ./scripts/env.mjs --import tsx scripts/create-smoke.ts",
    "test:async-requests": "node --import ./scripts/env.mjs --import tsx scripts/async-request-smoke.ts",
    "test:question-ui": "node --import tsx scripts/question-ui-smoke.ts",
    "configure": "node scripts/configure.mjs",
    "check:public": "node scripts/check-public.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.17",
    "fastify": "^5.12.8",
    "immer": "^11.2.9",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "shiki": "^4.6.0",
    "smol-toml": "^1.9.1",
    "unified": "^11.0.5",
    "werift": "^0.26.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "description": "Mobile companion for existing Linux Codex desktop chats"
}
