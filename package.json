{
  "name": "codex-pocket-remote",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "instance": "node --import ./scripts/env.mjs --import tsx src/server/backends/appearance-cli.ts",
    "dev": "node --import ./scripts/env.mjs --import tsx src/server/main.ts",
    "build": "npm run build:adapters && npm run build:server && npm run build:web && npm run package:adapters",
    "start": "node --import ./scripts/env.mjs dist/server/main.js",
    "pair": "node --import ./scripts/env.mjs --import tsx src/server/cli.ts pair",
    "devices": "node --import ./scripts/env.mjs --import tsx src/server/cli.ts devices",
    "doctor": "node --import ./scripts/env.mjs --import tsx scripts/doctor.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "format": "prettier --write src scripts test *.json *.ts docs/*.md README.md",
    "test:cloud": "node --import ./scripts/env.mjs --import tsx scripts/cloud-smoke.ts",
    "deploy:render": "node --import ./scripts/env.mjs --import tsx scripts/render-deploy.ts",
    "assets:prepare": "node --import ./scripts/env.mjs --import tsx scripts/prepare-assets.ts",
    "assets:publish": "node --import ./scripts/env.mjs --import tsx scripts/publish-assets.ts",
    "test:stun": "node --import ./scripts/env.mjs --import tsx scripts/stun-smoke.ts",
    "configure": "node scripts/configure.mjs",
    "check:public": "node scripts/check-public.mjs",
    "relay": "node --import ./scripts/env.mjs dist/server/relay-main.js",
    "test:v2": "node --import tsx scripts/v2-smoke.ts",
    "test:legacy:live": "node --import ./scripts/env.mjs --import tsx scripts/live-smoke.ts",
    "test:legacy:pairing": "node --import ./scripts/env.mjs --import tsx scripts/pairing-smoke.ts",
    "test:legacy:browser": "node --import ./scripts/env.mjs --import tsx scripts/browser-smoke.ts",
    "test:legacy:content": "node --import ./scripts/env.mjs --import tsx scripts/content-smoke.ts",
    "test:legacy:requests": "node --import ./scripts/env.mjs --import tsx scripts/request-smoke.ts",
    "test:legacy:storage": "node --import ./scripts/env.mjs --import tsx scripts/storage-smoke.ts",
    "test:legacy:approvals": "node --import ./scripts/env.mjs --import tsx scripts/approval-smoke.ts",
    "test:legacy:file-approval": "node --import ./scripts/env.mjs --import tsx scripts/file-permission-smoke.ts",
    "test:legacy:queue": "node --import ./scripts/env.mjs --import tsx scripts/queue-smoke.ts",
    "test:legacy:uploads": "node --import ./scripts/env.mjs --import tsx scripts/upload-smoke.ts",
    "test:legacy:create": "node --import ./scripts/env.mjs --import tsx scripts/create-smoke.ts",
    "test:legacy:async-requests": "node --import ./scripts/env.mjs --import tsx scripts/async-request-smoke.ts",
    "test:legacy:question-ui": "node --import tsx scripts/question-ui-smoke.ts",
    "test:browser": "node --import tsx scripts/v2-smoke.ts",
    "test:storage": "node --import ./scripts/env.mjs --import tsx scripts/v2-storage-smoke.ts",
    "test:public-browser": "node --import ./scripts/env.mjs --import tsx scripts/v2-public-browser-smoke.ts",
    "test:frontend": "node --import tsx scripts/v3-smoke.ts",
    "test:layout": "node --import tsx scripts/layout-recovery-smoke.ts",
    "test:composer": "node --import tsx scripts/adaptive-composer-smoke.ts",
    "test:controls": "node --import tsx scripts/conversation-controls-smoke.ts",
    "build:adapters": "node scripts/build-adapters.mjs",
    "adapter": "node --import ./scripts/env.mjs --import tsx src/server/adapters/cli.ts",
    "predev": "npm run build:adapters && npm run package:adapters",
    "test:adapters": "vitest run test/adapter-host.test.ts test/adapter-manager.test.ts",
    "test:adapter-ui": "node --import tsx scripts/adapter-ui-smoke.ts",
    "package:adapters": "node scripts/package-adapters.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "vite build",
    "test:packages": "vitest run --config vitest.packages.config.ts",
    "im": "node --import tsx scripts/im-agent.ts",
    "test:messaging": "node --import tsx scripts/im-smoke.mjs",
    "test:messaging-design": "node --import tsx scripts/im-design-smoke.mjs",
    "test:delivery": "node --import tsx scripts/delivery-feedback-smoke.mjs",
    "test:conversation-replay": "node --import tsx scripts/conversation-replay-smoke.ts",
    "im:migrate": "node --import ./scripts/env.mjs --import tsx scripts/im-encryption-migrate.ts",
    "typecheck:cf": "tsc -p tsconfig.cloudflare.json --noEmit",
    "build:cf": "node scripts/cloudflare.mjs build",
    "deploy:cf": "node scripts/cloudflare.mjs deploy",
    "dev:cf": "node scripts/cloudflare.mjs dev",
    "test:cf": "vitest run --config vitest.cloudflare.config.ts",
    "check:deployments": "node scripts/check-deployments.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/proxy-addr": "5.1.2",
    "@fastify/static": "^8.3.0",
    "@libp2p/crypto": "5.2.0",
    "@libp2p/interface": "3.4.0",
    "@libp2p/logger": "6.2.16",
    "@libp2p/noise": "17.0.7",
    "@libp2p/peer-id": "6.0.18",
    "@libp2p/utils": "7.4.5",
    "@material/material-color-utilities": "0.3.0",
    "@noble/hashes": "2.0.1",
    "@npmcli/arborist": "10.0.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cookie": "^2.0.1",
    "dompurify": "^3.4.17",
    "env-paths": "4.0.0",
    "execa": "10.2.1",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "idb": "8.0.4",
    "immer": "^11.2.9",
    "ipaddr.js": "2.5.0",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "pacote": "22.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "rimraf": "6.1.4",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "smol-toml": "^1.9.1",
    "uint8arraylist": "3.0.2",
    "unified": "^11.0.5",
    "vscode-jsonrpc": "10.0.0",
    "werift": "^0.26.0",
    "ws": "^8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/npmcli__arborist": "6.3.3",
    "@types/pacote": "11.1.8",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.0",
    "jsqr": "^1.4.0",
    "miniflare": "^5.20261104.0-beta",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  },
  "license": "MIT",
  "description": "Encrypted mobile remote for existing Codex desktop and DSH Web conversations",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "katex": "$katex"
  }
}
