# Public static PWA and ciphertext relay origin.
POCKET_PUBLIC_ORIGIN=https://codex.example.com
# Host enrollment credential shared with your relay; never expose in the browser.
POCKET_RELAY_ENROLLMENT=REPLACE_WITH_RANDOM_32_BYTES
# Optional public object-storage/CDN path for hashed JS/CSS only. Blank means same-origin.
# Must be identical during build and gateway startup. No credentials belong here.
# POCKET_ASSET_BASE=https://static.example.com/pocket/v1/
# Optional: defaults to ~/.local/state/codex-pocket-remote
# POCKET_STATE_DIR=/absolute/private/directory
# Optional: force observation-only mode even on a supported desktop build.
# POCKET_READ_ONLY=1
# Optional Node relay release storage root; contains desktop-releases/, keep outside build output.
# POCKET_DESKTOP_RELEASE_ROOT=/srv/agent-releases
# POCKET_DESKTOP_DOWNLOAD_BASE=https://downloads.example.com/site/
# Opportunistic WebRTC data channel; WSS remains the automatic fallback.
POCKET_P2P=1
# Optional STUN discovery servers, comma separated. No TURN relay is used.
# POCKET_STUN_URLS=stun:stun.example.com:3479
# Optional local storage adapters (.mjs/.js), loaded only on the desktop.
# Without a media adapter, files use encrypted direct/WSS channels.
# Adapter contract: docs/STORAGE_ADAPTER.md. No provider implementation is bundled.
# POCKET_MEDIA_ADAPTER=/absolute/path/to/storage-adapter.mjs
# POCKET_MEDIA_PREFIX=codex-pocket
# Optional adapter used only by assets:publish (public static files).
# POCKET_ASSET_ADAPTER=/absolute/path/to/asset-adapter.mjs

# Optional existing DSH Web instances, configured on the host only. See docs/BACKENDS.md.
# POCKET_BACKENDS_FILE=/absolute/private/backends.json
# DSH_ONE_TOKEN=<existing-web-access-token>
# Optional Codex connection overrides; no Agent process is launched.
# POCKET_CODEX_ROOT=/absolute/path/to/installation
# POCKET_CODEX_EXECUTABLE=/absolute/path/to/executable
# POCKET_CODEX_SOCKET=/absolute/path/to/ipc.sock
# POCKET_CODEX_APP_TOOLS=/absolute/path/to/app-tools.sock
# POCKET_PYTHON=python3

# Optional human-account registration code on the relay. Blank permits self-registration.
# Separate from relay host enrollment; Agent registration uses one-use user invitations.
# POCKET_IM_REGISTRATION_CODE=<private-registration-code>

# Optional in-app selection translation using a LibreTranslate endpoint.
# POCKET_TRANSLATION_URL=https://translate.example.com/translate
# POCKET_TRANSLATION_API_KEY=<server-side-secret>

# Persistent private IM attachments (separate from transient encrypted desktop media)
# POCKET_IM_MEDIA_ADAPTER=/absolute/path/to/private-adapter.mjs
# POCKET_IM_MEDIA_ORIGIN=https://private-objects.example.com

# Optional resource policy, identical on Node/VPS and Cloudflare.
# Omit all four values for an instance without membership quotas.
# Plan names and amounts are configured in Lago, never in a runtime-specific build.
# POCKET_LAGO_URL=https://billing-api.example.com
# POCKET_LAGO_API_KEY=<server-side-secret>
# POCKET_LAGO_DEFAULT_PLAN=<operator-selected-plan-code>
# POCKET_RESOURCE_INSTANCE=<stable-unique-instance-name>

# Account-to-account social features are off by default; personal Agent contacts remain available.
POCKET_IM_HUMAN_CONTACTS=false
# Optional WebRTC discovery/relay; configure for mobile/cross-NAT Agent calls.
POCKET_IM_CALL_STUN_URLS=
POCKET_IM_CALL_TURN_URLS=
POCKET_IM_CALL_TURN_SECRET=
