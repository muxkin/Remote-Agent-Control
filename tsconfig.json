{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "src",
    "scripts",
    "test",
    "vite.config.ts",
    "vitest.config.ts",
    "packages"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "packages/*/dist",
    "src/cloudflare"
  ]
}
